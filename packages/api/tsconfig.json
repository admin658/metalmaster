{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@metalmaster/shared-types": ["../../packages/shared-types/src"],
      "@metalmaster/shared-validation": ["../../packages/shared-validation/src"],
      "@metalmaster/shared-schemas": ["../../packages/shared-schemas/src"]
    },
    "outDir": "./dist",
    "rootDir": "./src",
    "noImplicitAny": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../shared-types" },
    { "path": "../shared-validation" },
    { "path": "../shared-schemas" }
  ]
}
